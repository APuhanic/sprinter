# Resend (transactional email). Sign up at https://resend.com
# Leave unset in dev — actions will log to console instead of sending.
RESEND_API_KEY=

# Where inquiries are routed. Comma-separated for multiple recipients (dad + backup).
# Falls back to sprinter@sprinter.hr if not set.
INQUIRY_TO=sprinter@sprinter.hr

# Verified sending domain in Resend. Must match SPF/DKIM-verified domain.
# REQUIRED whenever RESEND_API_KEY is set — dispatch fails closed otherwise.
MAIL_FROM=Sprinter <inquiries@sprinter.hr>

# Cloudflare Turnstile (CAPTCHA replacement). Register a site at
# https://dash.cloudflare.com/?to=/:account/turnstile — domain: sprinter.hr.
# Leave both unset to disable the challenge (dev/local).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
